# The app is a handful of small files and it changes often. Serving stale
# JavaScript to someone opening it for the first time is worse than the cost of
# revalidating, so nothing is cached without checking.
#
# The CSP is the promise enforced by the browser rather than asserted in prose.
# Everything the app needs is served from this origin, so connect-src is 'self'
# alone: no fetch, no XHR, no WebSocket and no beacon can reach another host. If
# a future change ever tried to upload a file, the browser would block it and
# say so in the console. `form-action 'none'` closes the other way out.
/*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data:; font-src 'self'; connect-src 'self' blob: data:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# The samples and the vendored libraries never change once published.
/demo-assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
